{
    "schemaVersion": 1,
    "id": "mts",
    "version": "${version}",
    "name": "Immersive Vehicles (MTS)",
    "description": "Realistic planes, cars, trucks and more, loaded from content packs!",
    "authors": [
        "don_bruce"
    ],
    "contact": {
        "homepage": "https://github.com/DonBruce64/MinecraftTransportSimulator"
    },
    "license": "All Rights Reserved",
    "icon": "vingette.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "mcinterfacefabric1201.InterfaceLoader"
        ],
        "client": [
            "mcinterfacefabric1201.InterfaceClientLoader"
        ]
    },
    "mixins": [
        "mts.mixins.json"
    ],
    "accessWidener": "mts.accesswidener",
    "depends": {
        "fabricloader": ">=0.15.0",
        "fabric-api": "*",
        "minecraft": "~1.20.1",
        "java": ">=17"
    }
}
